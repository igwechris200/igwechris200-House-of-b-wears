# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Environment variables — never commit real credentials
.env
.env.local
.env.*.local
.env.production
.env.development.local

# Keep the template so new clones know what to set
!.env.example

# Runtime-uploaded images (served from /api/uploads/*)
/uploads/*
!/uploads/.gitkeep

# Local test tooling scratch space
.tmp/
.tmp-*/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Drizzle output (we use `drizzle-kit push`, not generated migrations)
/drizzle

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
