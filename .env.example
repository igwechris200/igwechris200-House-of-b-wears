# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ───────────── Database (required) ─────────────
# Any PostgreSQL database: local, Supabase, Neon, Railway, Render…
# Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ───────────── Initial admin account (used once, on first launch) ─────────────
# Set these BEFORE the first start so the default password is never used in production.
ADMIN_EMAIL=owner@houseofbwears.com
ADMIN_PASSWORD=change-me-to-a-long-password

# ───────────── Paystack (optional but recommended) ─────────────
# https://dashboard.paystack.com/#/settings/developers
# The secret key is only used on the server. Never expose it in the browser.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Register this webhook in Paystack: https://<your-domain>/api/paystack/webhook

# ───────────── Site URL ─────────────
# Your public URL, used to build Paystack callback links, e.g. https://houseofbwears.com
NEXT_PUBLIC_SITE_URL=
