# ───────────── Database (REQUIRED) ─────────────
# Supabase → Project Settings → Database → Connection string → URI.
#
# For Vercel, use the TRANSACTION POOLER URI (port 6543) — serverless functions
# cannot hold long-lived connections:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Locally / on a long-running server, use the session pooler (port 5432).
DATABASE_URL=

# ───────────── Supabase Storage (recommended in production) ─────────────
# Supabase → Project Settings → API.
# Set these so uploaded product photos persist. Without them the app falls back
# to the server's local disk, which is lost on serverless redeploys.
# The service role key is SECRET — server-side only, never in NEXT_PUBLIC_*.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ───────────── Paystack (https://dashboard.paystack.com/#/settings/developers) ─────────────
# Secret key is ONLY used server-side (initialize / verify / webhook signature).
PAYSTACK_SECRET_KEY=
# Public key is safe to expose in the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Register this webhook URL in Paystack: https://<your-domain>/api/paystack/webhook

# ───────────── Site (REQUIRED for Vercel) ─────────────
# Your public URL. Used to build Paystack callback URLs.
# Locally: http://localhost:3000  On Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# ───────────── Initial admin account (used once, on first launch) ─────────────
# Only needed the first time the database is seeded. Change the password in
# Store Settings → Admin password afterwards.
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin@12345

# ───────────── Development only — DO NOT SET IN PRODUCTION ─────────────
# When "1", a request with no session cookie is treated as the most recent
# administrator. This exists only so the admin dashboard can be previewed inside
# a cross-site iframe that blocks cookies (e.g. a sandboxed preview).
# In production this would let ANY visitor into the admin dashboard. Leave empty.
ALLOW_COOKIELESS_ADMIN=
