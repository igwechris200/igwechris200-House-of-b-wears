# ───────────── Database ─────────────
# Local PostgreSQL (default) — or paste your Supabase Postgres connection string
# (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ───────────── Paystack (https://dashboard.paystack.com/#/settings/developers) ─────────────
# Secret key is ONLY used server-side (initialize / verify / webhook signature). Never expose it.
PAYSTACK_SECRET_KEY=
# Public key is optional (reserved for inline checkout); safe to expose.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Register this webhook URL in Paystack: https://<your-domain>/api/paystack/webhook

# ───────────── Supabase ─────────────
# Supabase → Project Settings → API. The URL is safe to expose; the service
# role key is SECRET and must only ever be used on the server.
# Set these to store uploaded product images in Supabase Storage (persistent).
# Leave them empty to store images on the server's local disk instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ───────────── Site ─────────────
# Used to build Paystack callback URLs in production (falls back to request host).
NEXT_PUBLIC_SITE_URL=

# ───────────── Development only — DO NOT SET IN PRODUCTION ─────────────
# When "1", a request with no session cookie is treated as the most recent
# administrator. This exists only so the admin dashboard can be previewed inside
# a cross-site iframe that blocks cookies (e.g. a sandboxed preview).
# In production this would let ANY visitor into the admin dashboard. Leave empty.
ALLOW_COOKIELESS_ADMIN=

# ───────────── Initial admin account (used once, on first launch) ─────────────
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin@12345
