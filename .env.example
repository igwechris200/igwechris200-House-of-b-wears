# Copy to `.env` for local development. On Vercel, add these in
# Project → Settings → Environment Variables instead. Never commit real values.

# ───────────── Database (REQUIRED) ─────────────
# Supabase → Connect → choose a pooler connection string, and put your real
# database password in place of [YOUR-PASSWORD].
#   Vercel:      Transaction pooler (port 6543) — serverless functions can't hold long connections
#   Local / VPS: Session pooler (port 5432) or direct connection
# Special characters in the password must be URL-encoded (@ → %40, # → %23, % → %25).
# SSL is switched on automatically for any non-local database.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Optional: max database connections per server instance (default 3 on Vercel, 10 elsewhere).
# DATABASE_POOL_MAX=3

# ───────────── Supabase Storage (recommended in production) ─────────────
# Supabase → Project Settings → API.
# Set these so uploaded product photos persist. Without them, uploads fall back
# to the server's local disk, which doesn't work on Vercel (paste image links instead).
# The service role key is SECRET — server-side only, never in NEXT_PUBLIC_*.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ───────────── Paystack (needed for online payments) ─────────────
# https://dashboard.paystack.com/#/settings/developers — the secret key stays on the server.
PAYSTACK_SECRET_KEY=
# The public key is safe to expose in the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Register this webhook in Paystack: https://<your-domain>/api/paystack/webhook

# ───────────── Site URL (needed for Paystack payment redirects) ─────────────
# Locally: http://localhost:3000   On Vercel: https://your-app.vercel.app or your own domain
NEXT_PUBLIC_SITE_URL=

# ───────────── Initial admin account (only used if NO admin exists yet) ─────────────
# Your Supabase database already has an admin, so these won't change it.
# Change the existing admin password in Admin → Store Settings instead.
ADMIN_EMAIL=owner@houseofbwears.com
ADMIN_PASSWORD=change-me-to-a-long-password

# ───────────── Development only — DO NOT SET IN PRODUCTION ─────────────
# When "1", a request with no session cookie is treated as the most recent
# administrator, so the admin dashboard can be previewed inside a cross-site
# iframe that blocks cookies. In production this would let ANY visitor into the
# admin dashboard. Leave empty.
ALLOW_COOKIELESS_ADMIN=
