# ───────────── Database ─────────────
# Local PostgreSQL (default) — or paste your Supabase Postgres connection string
# (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ───────────── Paystack (https://dashboard.paystack.com/#/settings/developers) ─────────────
# Secret key is ONLY used server-side (initialize / verify / webhook signature). Never expose it.
PAYSTACK_SECRET_KEY=
# Public key is optional (reserved for inline checkout); safe to expose.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Register this webhook URL in Paystack: https://<your-domain>/api/paystack/webhook

# ───────────── Site ─────────────
# Used to build Paystack callback URLs in production (falls back to request host).
NEXT_PUBLIC_SITE_URL=

# ───────────── Initial admin account (used once, on first launch) ─────────────
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin@12345
